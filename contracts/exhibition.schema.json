{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "塑机演示与商机交接现场资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "exhibitors",
    "operators",
    "machines",
    "events"
  ],
  "properties": {
    "domain": {
      "const": "plastics-demo"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "show": {
      "type": "object"
    },
    "exhibitors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "booth"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "booth": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "certs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "certs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "valid_until"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "valid_until": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "machines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "exhibitor_id",
          "model",
          "booth",
          "required_cert",
          "param_ranges",
          "material_batches",
          "molds",
          "risk_zones",
          "inspections"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "exhibitor_id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "booth": { "type": "string", "minLength": 1 },
          "required_cert": { "type": "string", "minLength": 1 },
          "param_ranges": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": [{ "type": "number" }, { "type": "number" }],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "material_batches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "material"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "material": { "type": "string", "minLength": 1 }
              }
            }
          },
          "molds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string" }
              }
            }
          },
          "risk_zones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "level": { "type": "string" }
              }
            }
          },
          "inspections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "version", "at", "result", "covers"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "integer", "minimum": 1 },
                "at": { "type": "string", "minLength": 1 },
                "result": { "enum": ["pass", "fail"] },
                "covers": {
                  "type": "object",
                  "required": ["material_batch_id", "mold_id"],
                  "properties": {
                    "material_batch_id": { "type": "string", "minLength": 1 },
                    "mold_id": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "type"],
        "properties": {
          "at": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "register_inspection",
              "approve_slot",
              "resume_slot",
              "complete_session",
              "scan",
              "record_params",
              "record_qa",
              "record_quote",
              "record_consent",
              "produce_sample",
              "dispose_sample",
              "guard_open",
              "abnormal_stop",
              "export"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
